# Flask 설정
PORT=5000
DEBUG=False

# Resend API 설정
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@pdfgrammercheckorean.site

# 바른(Bareun) API 설정
BAREUN_API_KEY=your_bareun_api_key_here
BAREUN_HOST=api.bareun.ai
BAREUN_PORT=443

# 토스페이먼츠 설정
TOSS_CLIENT_KEY=test_ck_your_client_key
TOSS_SECRET_KEY=test_sk_your_secret_key
TOSS_SUCCESS_URL=https://pdfgrammercheckorean.site/payment/success
TOSS_FAIL_URL=https://pdfgrammercheckorean.site/payment/fail

# CORS 설정
ALLOWED_ORIGINS=https://pdfgrammercheckorean.site,http://localhost:3000

# 파일 업로드 설정
MAX_FILE_SIZE_MB=20
